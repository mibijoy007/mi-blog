{
    "version": 2,
    "builds": [
      {
        "src": "package.json",
        "use": "@vercel/next"
      }
    ],

    "public": true,
    "regions": ["all"],
    "files": [
      "content/**",
      "public/**",
      "components/**",
      "pages/**",
      "styles/**",
      "app/**",
      "lib/**",
      "hooks/**",
      "package.json",
      "next.config.mjs",
      "tsconfig.json",
      "vercel.json",
      "tailwind.config.ts",
      "postcss.config.mjs",
      "next-env.d.ts",
      "mdx-components.tsx",
      "components.json"
    ]
  }